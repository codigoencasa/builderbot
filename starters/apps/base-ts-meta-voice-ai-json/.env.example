# Meta WhatsApp Business (Cloud API) — Calling API
META_JWT_TOKEN=
META_NUMBER_ID=
META_VERIFY_TOKEN=

# OpenAI — Whisper (STT) + TTS for the voice pipeline
OPENAI_API_KEY=

# STT language hint (ISO-639-1), e.g. en, es
STT_LANGUAGE=en

# HTTP server port
PORT=3008

# LLM that answers the caller
OPENAI_MODEL=gpt-4o-mini
SYSTEM_PROMPT=You are a helpful phone assistant. Answer in one or two short sentences.
