# Meta WhatsApp Business (Cloud API) — Calling API
META_JWT_TOKEN=
META_NUMBER_ID=
META_VERIFY_TOKEN=

# Speech providers. Default: OpenAI (Whisper for STT, OpenAI TTS for the replies).
OPENAI_API_KEY=

# Alternative: Inworld for STT + TTS, shipped with @builderbot/provider-voice
# (InworldSTTAdapter / InworldTTSAdapter). One credential covers both directions
# and the TTS WebSocket streams audio while it is still being generated.
# INWORLD_API_KEY=
# INWORLD_VOICE_ID=Ashley
# INWORLD_TTS_MODEL=inworld-tts-2-flash
# INWORLD_REGION=us

# STT language hint (ISO-639-1), e.g. en, es
STT_LANGUAGE=en

# HTTP server port
PORT=3008

# LLM that answers the caller
OPENAI_MODEL=gpt-4o-mini
SYSTEM_PROMPT=You are a helpful phone assistant. Answer in one or two short sentences.
